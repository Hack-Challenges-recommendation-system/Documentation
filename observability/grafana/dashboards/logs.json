{
  "uid": "alpha-logs",
  "title": "04 · Журналы сервисов",
  "tags": [
    "alfa-course",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Ошибки и предупреждения",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=~\"api-gateway|auth-service|profile-service|catalog-service|metric-service|recommendation-service\"} | json | log_level=~\"WARN|ERROR\" | line_format \"{{.message}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 2,
      "title": "Журнал рекомендателя",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"recommendation-service\"} | json | line_format \"{{.message}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 3,
      "title": "Журнал gateway",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"api-gateway\"} | json | line_format \"{{.message}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}

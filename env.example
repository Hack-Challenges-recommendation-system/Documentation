# Copy to .env to change the defaults of docker-compose.yaml. Never commit .env.
# An empty value means "use the default".

# Port of the web app: http://localhost:8080
APP_PORT=
GRAFANA_PORT=

# Where published images come from: <DOCKERHUB_USER>/hackathon-recommendation-system-<service>:<IMAGE_TAG>
DOCKERHUB_USER=
IMAGE_TAG=

# Infrastructure passwords; the defaults are for a local demo only.
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Signs access and refresh tokens; at least 64 characters. Set your own for any shared deployment.
JWT_SECRET=

# Browser origins allowed to call the API directly; default: localhost on any port and https://cson.site
CORS_ALLOWED_ORIGINS=

# Anthropic API key for recommendation-service; without it, recommendations come from the topic-match baseline
ANTHROPIC_API_KEY=
AB_LLM_SHARE=

# The case data: put alfa_course_hackathon.backup into ./data, and the case-data service exports it on every start.
# Defaults: file:/export/catalog.json and file:/export/events.json, written by that service.
CATALOG_IMPORT_PATH=
EVENTS_IMPORT_PATH=

# Build an app from a local clone instead of GitHub, e.g. AUTH_SERVICE_BUILD=../auth-service
AUTH_SERVICE_BUILD=
PROFILE_SERVICE_BUILD=
CATALOG_SERVICE_BUILD=
METRIC_SERVICE_BUILD=
RECOMMENDATION_SERVICE_BUILD=
API_GATEWAY_BUILD=
FRONTEND_BUILD=
